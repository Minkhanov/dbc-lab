{
  "name": "dbc-lab",
  "version": "0.1.0",
  "private": true,
  "description": "DBC Lab: simulator, preset library and config exporter for Meteora Dynamic Bonding Curve launches",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "devnet:keygen": "tsx scripts/gen-devnet-keypair.ts",
    "devnet:airdrop": "tsx scripts/airdrop.ts",
    "devnet:dryrun": "tsx scripts/dryrun-config.ts",
    "devnet:conformance": "tsx scripts/conformance-devnet.ts",
    "devnet:config": "tsx src/devnet/run.ts config",
    "devnet:pool": "tsx src/devnet/run.ts pool",
    "devnet:buys": "tsx src/devnet/run.ts buys",
    "devnet:migrate": "tsx src/devnet/run.ts migrate",
    "devnet:all": "tsx src/devnet/run.ts all",
    "devnet:proof": "tsx scripts/render-proof.ts",
    "devnet:dryrun:pool": "tsx scripts/dryrun-pool-and-migration.ts",
    "devnet:conformance:timing": "tsx scripts/conformance-timing.ts",
    "presets:compare": "tsx scripts/compare-presets.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.13",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}